{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>basher83/renovate-config",
        "local>basher83/renovate-config//presets/python-mcp.json",
        "local>basher83/renovate-config//presets/github-actions-security.json",
        "local>basher83/renovate-config//presets/docker.json"
    ],
    "labels": [
        "dependencies",
        "renovate"
    ],
    "assignees": [
        "basher83"
    ],
    "commitMessagePrefix": "chore(deps):",
    "packageRules": [
        {
            "description": "Keep Python pinned below 3.14 until MCP SDK v1.x officially supports it",
            "matchDepNames": [
                "python"
            ],
            "allowedVersions": "<3.14"
        },
        {
            "description": "Update the Python pins in mise.toml and .python-version in one PR (scripts/validate.sh fails when they differ)",
            "matchManagers": [
                "mise",
                "pyenv"
            ],
            "matchDepNames": [
                "python"
            ],
            "groupName": "python version pins"
        },
        {
            "description": "Update the uv pins in mise.toml, the setup-uv steps, and the uv-pre-commit hook in one PR (scripts/validate.sh fails when they differ)",
            "matchDepNames": [
                "uv",
                "astral-sh/uv",
                "astral-sh/uv-pre-commit"
            ],
            "groupName": "uv version pins"
        },
        {
            "description": "Require approval for major Zammad API updates",
            "matchPackageNames": [
                "zammad-py"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "dependencyDashboardApproval": true
        }
    ]
}
